NODE_ENV=development
WEB_PORT=5173
SERVER_PORT=8787
PUBLIC_SERVER_URL=http://localhost:8787

# Optional PostgreSQL persistence. If blank, the server uses ./data/local-db.json.
DATABASE_URL=

# AI. mock works without any API key.
# When ready to connect, set AI_PROVIDER=openai-compatible (or multi-provider)
AI_PROVIDER=multi-provider
AI_MODELS=Claude-3.5-Sonnet,GPT-4o,Gemini-1.5-Pro

# Global fallback relay
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=500

# Optional: Distinct Relay Group for Claude (format: openai or anthropic)
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_FORMAT=anthropic

# Optional: Distinct Relay Group for GPT (format: openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FORMAT=openai

# Optional: Distinct Relay Group for Gemini (format: openai or gemini)
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FORMAT=openai

# Translation uses the same AI provider by default.
TRANSLATION_PROVIDER=ai
DEFAULT_LANGUAGE=en
AI_POPULATION=18
WORLD_SEED=who-is-ai-v1
