{
  "name": "who-is-ai-v1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:server": "npm --workspace apps/server run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/server run start",
    "test": "node --test tests/*.test.mjs",
    "generate-assets": "python scripts/generate_assets.py",
    "play": "node apps/server/src/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
